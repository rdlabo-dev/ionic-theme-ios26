{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ionic-theme-ios26-demo",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./demo/www",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "ionic-theme-ios26.rdlabo.dev",
      "custom_domain": true,
    },
  ],
  "env": {
    "ionic8": {
      "name": "ionic-theme-ios26-demo-v8",
      "routes": [
        {
          "pattern": "ionic8-theme-ios26.rdlabo.dev",
          "custom_domain": true,
        },
      ],
    },
  },
}
